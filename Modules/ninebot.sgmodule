#!name=九号出行签到
#!desc=首次抓取 Token 后每天自动签到；抓取成功后可关闭 MITM，继续使用已保存的 Token 签到。
#!author=llle0x
#!category=llle0x
#!arguments=CaptureHost:cn-cbu-gateway.ninebot.com,CronExp:10 8 * * *
#!arguments-desc=CaptureHost 为抓取域名，通常无需修改；CronExp 为每日签到时间。首次抓取时移除文末 MITM 两行前的 #，抓取成功后加回 #，避免持续进行不必要的 MITM。

[Script]
Ninebot_Header = type=http-request,pattern=^https://cn-cbu-gateway\.ninebot\.com/(portal|app-api)/api/user-sign/,requires-body=false,script-path=https://raw.githubusercontent.com/llle0x/Surge/main/Scripts/ninebot.js,argument="{{{CaptureHost}}}"
Ninebot_Checkin = type=cron,cronexp="{{{CronExp}}}",wake-system=true,timeout=60,script-path=https://raw.githubusercontent.com/llle0x/Surge/main/Scripts/ninebot.js

# 首次抓取 Token 时，移除下面两行前的 #；抓取成功后加回 #，每日签到不受影响。
#[MITM]
#hostname = %INSERT% {{{CaptureHost}}}
